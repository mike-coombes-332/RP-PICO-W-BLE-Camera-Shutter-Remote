PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "PicoW Shutter"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// Battery Service (Required by iOS/Android for HID devices)
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_BATTERY_SERVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_BATTERY_LEVEL, READ | NOTIFY,
CLIENT_CHARACTERISTIC_CONFIGURATION, READ | WRITE,

// Device Information Service
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_DEVICE_INFORMATION
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PNP_ID, READ, 02 01 00 01 00 01 00

// HID Service
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_HUMAN_INTERFACE_DEVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_INFORMATION, READ, 01 01 00 02
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT_MAP, READ | DYNAMIC,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_CONTROL_POINT, WRITE_WITHOUT_RESPONSE | DYNAMIC,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PROTOCOL_MODE, READ | WRITE_WITHOUT_RESPONSE | DYNAMIC,

// Input Report (Carries the Volume Up key press)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, READ | NOTIFY | DYNAMIC,
CLIENT_CHARACTERISTIC_CONFIGURATION, READ | WRITE,
REPORT_REFERENCE, READ, 1, 1